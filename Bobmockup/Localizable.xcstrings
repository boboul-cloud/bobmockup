    "Le compteur s'arrête ici.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The counter stops here."
          }
        }
      }
    },
    "Le même visuel recomposé pour les quatre formats requis. Le cadrage est recalculé, jamais étiré.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same visual recomposed for the four required sizes. The framing is recalculated, never stretched."
          }
        }
      }
    },
    "Le projet et sa capture seront effacés définitivement.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project and its screenshot will be erased permanently."
